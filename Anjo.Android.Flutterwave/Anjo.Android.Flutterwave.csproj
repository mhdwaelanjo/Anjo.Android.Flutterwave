<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net7.0-android;net6.0-android;</TargetFrameworks>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>Anjo.Android.Flutterwave</PackageId>
		<PackageVersion>2.1.39.1</PackageVersion>
		<AssemblyVersion>2.1.39.1</AssemblyVersion>
		<FileVersion>2.1.39.1</FileVersion>
		<Version>2.1.39.1</Version>
		<Title>Anjo Android Flutterwave SDK</Title>
		<Authors>Wael Anjo</Authors>
		<Owners>Wael Anjo</Owners>
		<PackageProjectUrl>https://github.com/mhdwaelanjo/Anjo.Android.Flutterwave</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<Description>.NET for Android (formerly Xamarin.Android) Binding Library - Flutterwave SDK</Description>
		<PackageReleaseNotes>Flutterwave SDK v2.1.39.1</PackageReleaseNotes>
		<Copyright>Copyright (c) 2023 Wael Anjo</Copyright>
		<PackageTags>Xamarin.Android, Flutterwave, Android, credit cards, Payment Gateway, Money, Bank_Account, Wallet, Cards</PackageTags>
		<Summary>Flutterwave's Android SDK can be used to integrate the Flutterwave payment gateway into your android app. It comes with a ready-made Drop In UI and non-UI module, depending on your preference.</Summary>
		<!-- Include symbol files (*.pdb) in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Square.OkHttp3" Version="4.9.3.2" />
		<PackageReference Include="Square.OkHttp3.LoggingInterceptor" Version="4.6.0" /> 
		<PackageReference Include="Square.Retrofit2" Version="2.9.0" />
		<PackageReference Include="Square.Retrofit2.ConverterGson" Version="2.9.0" />
		<PackageReference Include="Square.Retrofit2.ConverterScalars" Version="2.9.0" />  
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.6.0.1" />
		<PackageReference Include="Xamarin.AndroidX.CardView" Version="1.0.0.18" />
		<PackageReference Include="Xamarin.AndroidX.Legacy.Support.V4" Version="1.0.0.16" />
		<PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.2.1.9" />
		<PackageReference Include="Xamarin.Google.Android.Material" Version="1.7.0.2" />
		<PackageReference Include="Xamarin.Google.Dagger" Version="2.44.2.1" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\Anjo.Android.Flutterwave.Cache\Anjo.Android.Flutterwave.Cache.csproj" />
	  <ProjectReference Include="..\Anjo.Android.Flutterwave.Commons\Anjo.Android.Flutterwave.Commons.csproj" />
	  <ProjectReference Include="..\Anjo.Android.Flutterwave.Core\Anjo.Android.Flutterwave.Core.csproj" />
	  <ProjectReference Include="..\Anjo.Android.Flutterwave.Logger\Anjo.Android.Flutterwave.Logger.csproj" />
	  <ProjectReference Include="..\Anjo.Android.Flutterwave.Presentation\Anjo.Android.Flutterwave.Presentation.csproj" />
	  <ProjectReference Include="..\Anjo.Android.Flutterwave.Remote\Anjo.Android.Flutterwave.Remote.csproj" />
	  <ProjectReference Include="..\Anjo.Android.Flutterwave.Utils\Anjo.Android.Flutterwave.Utils.csproj" />
	</ItemGroup>
</Project>