<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net8.0-android;</TargetFrameworks>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>Anjo.Android.Flutterwave.Presentation</PackageId>
		<PackageVersion>2.1.39.3</PackageVersion>
		<AssemblyVersion>2.1.39.3</AssemblyVersion>
		<FileVersion>2.1.39.3</FileVersion>
		<Version>2.1.39.3</Version>
		<Title>Anjo Android Flutterwave.Presentation SDK</Title>
		<Authors>Wael Anjo</Authors>
		<Owners>Wael Anjo</Owners>
		<PackageProjectUrl>https://github.com/mhdwaelanjo/Anjo.Android.Flutterwave</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<Description>.NET for Android (formerly Xamarin.Android) Binding Library - Flutterwave.Presentation SDK</Description>
		<PackageReleaseNotes>Flutterwave.Presentation SDK v2.1.39</PackageReleaseNotes>
		<Copyright>Copyright (c) 2025 Wael Anjo</Copyright>
		<PackageTags>Xamarin.Android, Flutterwave, Android, credit cards, Payment Gateway, Money, Bank_Account, Wallet, Cards</PackageTags>
		<Summary>Flutterwave's Android SDK can be used to integrate the Flutterwave payment gateway into your android app. It comes with a ready-made Drop In UI and non-UI module, depending on your preference.</Summary>
		<!-- Include symbol files (*.pdb) in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="Jars\rave_presentation-release.aar" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Square.OkHttp3" Version="4.12.0.8" />
		<PackageReference Include="Square.OkHttp3.LoggingInterceptor" Version="4.12.0.8" />
		<PackageReference Include="Square.Retrofit2" Version="2.11.0.4" />
		<PackageReference Include="Square.Retrofit2.ConverterGson" Version="2.11.0.4" />
		<PackageReference Include="Square.Retrofit2.ConverterScalars" Version="2.11.0.4" />
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.0.5" />
		<PackageReference Include="Xamarin.AndroidX.CardView" Version="1.0.0.33" />
		<PackageReference Include="Xamarin.AndroidX.Legacy.Support.V4" Version="1.0.0.31" />
		<PackageReference Include="Xamarin.Google.Android.Material" Version="1.12.0.2" />
		<PackageReference Include="Xamarin.Google.Dagger" Version="2.55.0.1" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\Anjo.Android.Flutterwave.Cache\Anjo.Android.Flutterwave.Cache.csproj" />
	  <ProjectReference Include="..\Anjo.Android.Flutterwave.Commons\Anjo.Android.Flutterwave.Commons.csproj" />
	  <ProjectReference Include="..\Anjo.Android.Flutterwave.Core\Anjo.Android.Flutterwave.Core.csproj" />
	  <ProjectReference Include="..\Anjo.Android.Flutterwave.Logger\Anjo.Android.Flutterwave.Logger.csproj" />
	  <ProjectReference Include="..\Anjo.Android.Flutterwave.Remote\Anjo.Android.Flutterwave.Remote.csproj" />
	</ItemGroup>
</Project>